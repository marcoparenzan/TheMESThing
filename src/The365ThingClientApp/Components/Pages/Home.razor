@page "/"

<PageTitle>Office 365 Hub</PageTitle>

<div class="card">
    <div class="card-header">
        <h2 class="card-title">☁️ Welcome to Office 365 Hub</h2>
    </div>
    <div style="padding: 1.25rem 1.5rem;">
        <p style="font-size: 1rem; color: #374151; margin-bottom: 1.5rem;">
            Manage EntraID users and view your calendar all in one place. This is your central hub for Office 365 management tasks.
        </p>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem;">
            <div style="background: #eff6ff; border-left: 4px solid #3b82f6; padding: 1rem; border-radius: 6px;">
                <h3 style="margin: 0 0 0.5rem 0; color: #1e3a8a;">👥 User Management</h3>
                <p style="margin: 0; font-size: 0.9rem; color: #475569;">
                    Manage users, view profiles, and control user access and permissions.
                </p>
                <a href="/office365/users" style="margin-top: 0.5rem; display: inline-block; color: #3b82f6; text-decoration: none; font-weight: 500;">
                    Go to Users →
                </a>
            </div>

            <div style="background: #f0fdf4; border-left: 4px solid #10b981; padding: 1rem; border-radius: 6px;">
                <h3 style="margin: 0 0 0.5rem 0; color: #15803d;">📅 Calendar</h3>
                <p style="margin: 0; font-size: 0.9rem; color: #475569;">
                    View and manage your calendar events, schedule meetings, and track important dates.
                </p>
                <a href="/office365/calendar" style="margin-top: 0.5rem; display: inline-block; color: #10b981; text-decoration: none; font-weight: 500;">
                    Go to Calendar →
                </a>
            </div>
        </div>

        <div style="margin-top: 2rem; padding: 1rem; background: #fef3c7; border-radius: 6px; border-left: 4px solid #f59e0b;">
            <p style="margin: 0; font-size: 0.9rem; color: #92400e;">
                <strong>ℹ️ Tip:</strong> Use the sidebar navigation to access Users and Calendar at anytime.
            </p>
        </div>
    </div>
</div>
